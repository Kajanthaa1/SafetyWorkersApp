rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdminOrSupervisor() {
      let role = getUserData().role;
      return role == 'admin' || role == 'supervisor';
    }

    match /users/{userId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() && isOwner(userId);

      allow update, delete: if isAuthenticated() && (isOwner(userId) || isAdminOrSupervisor());
    }

    match /vitals/{document} {

      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdminOrSupervisor());

      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdminOrSupervisor());

      allow update, delete: if isAuthenticated() && isAdminOrSupervisor();
    }

    match /attendance/{document} {
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdminOrSupervisor());
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdminOrSupervisor());
      allow update, delete: if isAuthenticated() && isAdminOrSupervisor();
    }

    match /tasks/{taskId} {

      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdminOrSupervisor());

      allow create, update, delete: if isAuthenticated() && isAdminOrSupervisor();

      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }

    match /alerts/{alertId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdminOrSupervisor());

      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdminOrSupervisor());

      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdminOrSupervisor());
      allow delete: if isAuthenticated() && isAdminOrSupervisor();
    }
  }
}
